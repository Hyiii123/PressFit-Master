<Window x:Class="PressFit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PressFit.UI.ViewModels"
        mc:Ignorable="d"
        Title="PressFit-Master 智能产线多工位精密伺服压装监控系统 v1.0" 
        Height="870" Width="1420"
        MinHeight="750" MinWidth="1200"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />  <!-- 顶部状态栏 -->
            <RowDefinition Height="*" />   <!-- 主体操作与监控区 -->
            <RowDefinition Height="Auto" /> <!-- 底部仿真与故障注入抽屉 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部全局状态栏 -->
        <Border Grid.Row="0" Background="#161E28" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 系统标题与版本 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="22" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="PressFit-Master" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <Border Background="#243242" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="精密伺服压装工位上位机" FontSize="12" Foreground="{StaticResource AccentCyan}" />
                    </Border>
                </StackPanel>

                <!-- 中间设备在线与通信指示灯 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="20" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding IsConnected, Converter={x:Null}, FallbackValue=#00B894}" />
                            <TextBlock Text="Modbus TCP: " Foreground="{StaticResource TextSecondary}" FontSize="13" />
                            <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="SemiBold" Foreground="White" FontSize="13" Margin="4,0,15,0" />
                            
                            <TextBlock Text="整机状态: " Foreground="{StaticResource TextSecondary}" FontSize="13" />
                            <TextBlock Text="{Binding MachineStateText}" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" FontSize="13" Margin="4,0,15,0" />

                            <TextBlock Text="工艺时序: " Foreground="{StaticResource TextSecondary}" FontSize="13" />
                            <TextBlock Text="{Binding PressPhaseText}" FontWeight="SemiBold" Foreground="{StaticResource StatusWarn}" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧功能导航与权限控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 业务功能按钮 -->
                    <Button Content="⚙️ 配方标定" Command="{Binding OpenRecipeManagerCommand}" 
                            Background="#243346" Foreground="White" FontWeight="SemiBold"
                            Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" />

                    <Button Content="📈 生产追溯" Command="{Binding OpenHistoryQueryCommand}" 
                            Background="#243346" Foreground="White" FontWeight="SemiBold"
                            Padding="10,6" Margin="0,0,14,0" BorderThickness="0" Cursor="Hand" />

                    <!-- 用户权限身份卡片 -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="#3B4B60" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentUserRoleText}" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Content="切换权限" Command="{Binding SwitchRoleCommand}" 
                            Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold"
                            Padding="8,5" Margin="0,0,14,0" BorderThickness="0" Cursor="Hand" />

                    <!-- 连接断开控制 -->
                    <Button Content="连接" Command="{Binding ConnectCommand}" 
                            Background="#00B894" Foreground="White" FontWeight="Bold"
                            Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="断开" Command="{Binding DisconnectCommand}" 
                            Background="#2D3748" Foreground="{StaticResource TextSecondary}"
                            Padding="10,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 主体区 (三栏布局: 配方参数 / 核心曲线监控 / 生产统计与日志) -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" /> <!-- 左侧工艺与工件控制 -->
                <ColumnDefinition Width="*" />   <!-- 中央曲线与大屏监控 -->
                <ColumnDefinition Width="340" /> <!-- 右侧生产KPI与日志 -->
            </Grid.ColumnDefinitions>

            <!-- 左栏: 工艺配方与操作面板 -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📋 工艺配方 (Recipe)" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            <Button Content="⚙️ 管理" Command="{Binding OpenRecipeManagerCommand}"
                                    HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource AccentCyan}"
                                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                        
                        <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" Height="36" Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RecipeCode}" FontWeight="Bold" Foreground="#00D2D3" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ProductName, StringFormat='({0})'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <TextBlock Text="产品型号:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SelectedRecipe.ProductName}" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- 配方参数卡片 -->
                        <Border Background="#131B24" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <TextBlock Text="目标压深:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="White" FontWeight="Bold">
                                        <Run Text="{Binding SelectedRecipe.TargetDisplacement, StringFormat='{}{0:F2}'}" /> <Run Text="mm" Foreground="#64748B" />
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="位移公差:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="White">
                                        <Run Text="± " /><Run Text="{Binding SelectedRecipe.DisplacementTolerance, StringFormat='{}{0:F2}'}" /> <Run Text="mm" Foreground="#64748B" />
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="压力上限:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource StatusNg}" FontWeight="Bold">
                                        <Run Text="{Binding SelectedRecipe.MaxForceLimit, StringFormat='{}{0:F2}'}" /> <Run Text="kN" Foreground="#64748B" />
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="压力下限:" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource StatusOk}" FontWeight="Bold">
                                        <Run Text="{Binding SelectedRecipe.MinForceLimit, StringFormat='{}{0:F2}'}" /> <Run Text="kN" Foreground="#64748B" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🔍 工件条码 (Barcode / SN)" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                        <TextBox Text="{Binding WorkpieceBarcode, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                 Background="#243040" Foreground="White" BorderBrush="#3B4B60" 
                                 VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,20" />

                        <!-- 启动与急停动作按钮 -->
                        <Button Content="▶ 触发启动压装周期" Command="{Binding StartCycleCommand}"
                                Height="46" Background="#00B894" Foreground="White" FontSize="15" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" />

                        <Button Content="🛑 紧急停止 (E-STOP)" Command="{Binding EmergencyStopCommand}"
                                Height="42" Background="#D63031" Foreground="White" FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中栏: 实时数据指标看板与位移-压力包络线图表 -->
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" /> <!-- 4大指标仪表盘 -->
                    <RowDefinition Height="*" />   <!-- 实时曲线画布 -->
                    <RowDefinition Height="70" />  <!-- 巨大判定结果横幅 -->
                </Grid.RowDefinitions>

                <!-- 指标卡片 -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <!-- 卡片 1: 实时位移 -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,6,0" Padding="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="当前位移 (Displacement)" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,4,0,0">
                                <Run Text="{Binding CurrentDisplacement, StringFormat='{}{0:F2}'}" />
                                <Run Text=" mm" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2: 实时压力 -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="3,0,3,0" Padding="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="实时压力 (Force)" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#FDCB6E" Margin="0,4,0,0">
                                <Run Text="{Binding CurrentForce, StringFormat='{}{0:F2}'}" />
                                <Run Text=" kN" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 3: 峰值压力 -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="3,0,3,0" Padding="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="峰值压力 (Peak)" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,4,0,0">
                                <Run Text="{Binding PeakForce, StringFormat='{}{0:F2}'}" />
                                <Run Text=" kN" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 4: 节拍耗时 -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="6,0,0,0" Padding="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="周期耗时 (Duration)" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,0">
                                <Run Text="{Binding CycleTimeMs, StringFormat='{}{0:F0}'}" />
                                <Run Text=" ms" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 曲线呈现区 -->
                <Border Grid.Row="1" Background="#0F151D" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,10">
                    <Grid>
                        <!-- 图表标题与包络线图例 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15">
                            <Ellipse Width="8" Height="8" Fill="#00D2D3" Margin="0,0,4,0" />
                            <TextBlock Text="实时轨迹 (F-s)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,15,0" />
                            <Ellipse Width="8" Height="8" Fill="#E17055" Margin="0,0,4,0" />
                            <TextBlock Text="公差包络上限" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,15,0" />
                            <Ellipse Width="8" Height="8" Fill="#0984E3" Margin="0,0,4,0" />
                            <TextBlock Text="公差包络下限" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>

                        <!-- 自定义高性能轻量矢量波形画布 (零依赖，支持 60FPS 实时绘制) -->
                        <Canvas x:Name="CurveCanvas" ClipToBounds="True" Margin="30,30,30,30" />
                    </Grid>
                </Border>

                <!-- 底部品质判定巨大横幅 -->
                <Border Grid.Row="2" Background="#16202C" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{Binding QualityResultText}" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentCyan}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 右栏: 生产数据统计与实时事件日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" /> <!-- KPI 统计 -->
                    <RowDefinition Height="*" />   <!-- 事件流水 -->
                </Grid.RowDefinitions>

                <!-- 生产统计 KPI -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="📊 生产质量统揽 (Quality KPI)" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,12,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="总计生产 (Total):" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="良品数 (OK):" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding OkCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource StatusOk}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="次品数 (NG):" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding NgCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource StatusNg}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="综合良率 (Yield):" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource StatusWarn}">
                                    <Run Text="{Binding YieldRate, StringFormat='{}{0:F1}'}" /><Run Text="%" FontSize="14" />
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 实时流水日志 -->
                <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📝 系统事件流 (Event Stream)" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding LogMessages}" 
                                 Background="Transparent" BorderThickness="0" Foreground="#CBD5E1" FontSize="11" FontFamily="Consolas">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. 底部抽屉: 工业虚拟从机与故障注入控制台 (演示与面试核心利器) -->
        <Expander Grid.Row="2" Background="#111720" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                  Header="🛠️ 高保真虚拟从机与故障注入控制台 (Virtual Slave &amp; Fault Injection)" 
                  Foreground="{StaticResource AccentCyan}" FontWeight="Bold" IsExpanded="True">
            <Border Background="#17202C" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 仿真器主开关 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">
                        <Button Content="{Binding IsSimulatorRunning, Converter={x:Null}, FallbackValue='内置仿真从机 (运行中)'}" 
                                Command="{Binding ToggleSimulatorCommand}"
                                Background="#2D3748" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>

                    <!-- 故障注入多选列表 -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox Content="⚡ 模拟网络断开 (Drop)" IsChecked="{Binding FaultDisconnect}" Foreground="White" Margin="0,0,15,0" />
                        <CheckBox Content="⏳ 模拟通信严重超时 (Timeout)" IsChecked="{Binding FaultTimeout}" Foreground="White" Margin="0,0,15,0" />
                        <CheckBox Content="⚠️ 注入过盈卡滞超限 (Spike NG)" IsChecked="{Binding FaultForceSpike}" Foreground="#FF7675" Margin="0,0,15,0" />
                        <CheckBox Content="⚠️ 注入配合过松压力低 (Low NG)" IsChecked="{Binding FaultForceLow}" Foreground="#FDCB6E" Margin="0,0,15,0" />
                        <CheckBox Content="⚠️ 注入未到位提前停机 (Short NG)" IsChecked="{Binding FaultDispShort}" Foreground="#74B9FF" Margin="0,0,15,0" />
                        <CheckBox Content="🚨 模拟伺服驱动器报警 (Alarm)" IsChecked="{Binding FaultServoAlarm}" Foreground="#D63031" Margin="0,0,15,0" />
                    </WrapPanel>

                    <!-- 确认应用按钮 -->
                    <Button Grid.Column="2" Content="同步注入配置" Command="{Binding ApplyFaultsCommand}"
                            Background="#0984E3" Foreground="White" FontWeight="Bold"
                            Padding="14,6" BorderThickness="0" Cursor="Hand" />
                </Grid>
            </Border>
        </Expander>
    </Grid>
</Window>

