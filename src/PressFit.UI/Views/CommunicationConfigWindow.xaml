<Window x:Class="PressFit.UI.Views.CommunicationConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多协议通信网络参数配置与连通性测试" 
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🌐 工业多协议通信参数配置 (Driver Configuration)" FontSize="18" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="支持 Modbus TCP 与西门子 S7-1200/1500 双核心驱动无缝热切换" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- 表单 -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="18">
            <StackPanel>
                <!-- 协议选型 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="通信协议类型 (Protocol Type):" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbProtocol" Height="34" SelectionChanged="CmbProtocol_SelectionChanged">
                            <ComboBoxItem Content="Modbus TCP (标准工业以太网)" Tag="Modbus" IsSelected="True" />
                            <ComboBoxItem Content="Siemens S7-1200/1500 (西门子专有协议)" Tag="Siemens" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="通信端口 (Port):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtPort" Height="34" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="从机 PLC IP 地址 (IPv4):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtIp" Height="34" Margin="0,20,0,0" />
                </Grid>

                <!-- 西门子 S7 专有配置区域 -->
                <Border x:Name="SiemensSettingsPanel" Background="#162230" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚙️ 西门子 S7-1200/1500 硬件槽位与 DB 块参数" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,6" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="机架号 (Rack):" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="TxtRack" Height="28" Text="0" />
                            </StackPanel>
                            <StackPanel Margin="3,0,3,0">
                                <TextBlock Text="槽位号 (Slot):" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="TxtSlot" Height="28" Text="1" />
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="数据块 (DB No.):" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="TxtDbNo" Height="28" Text="1" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="数采轮询周期 (ms - 20ms对应50Hz):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtPolling" Height="34" />
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="通信超时阈值 (ms):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtTimeout" Height="34" />
                    </StackPanel>
                </UniformGrid>

                <!-- 连通性测试区 -->
                <Border Background="#121B24" CornerRadius="6" Padding="10" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⚡ 连通性探针测试" Click="PingTest_Click" 
                                Width="140" Height="32" Background="#243346" Foreground="{StaticResource AccentCyan}" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                        <TextBlock Grid.Column="1" x:Name="TxtPingResult" Text="点击左侧按钮预检目标地址与端口通断..." 
                                   VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 底部保存按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="💾 保存并热应用" Click="SaveConfig_Click" Width="140" Height="36" 
                    Background="{StaticResource StatusOk}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" />
            <Button Content="取消" Click="Cancel_Click" Width="80" Height="36" 
                    Background="#2D3748" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
