<Window x:Class="PressFit.UI.Views.HistoryQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生产履历全过程追溯与曲线复盘系统" 
        Height="780" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 顶部筛选器 -->
            <RowDefinition Height="*" />    <!-- 主体：列表与回放曲线分栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部搜索筛选栏 -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="起止日期:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker x:Name="DpStart" Width="130" Height="34" Margin="0,0,8,0" />
                    <TextBlock Text="至" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker x:Name="DpEnd" Width="130" Height="34" Margin="0,0,15,0" />

                    <TextBlock Text="条码检索:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="TxtBarcodeFilter" Width="160" Height="34" Margin="0,0,15,0" VerticalContentAlignment="Center" />

                    <Button Content="🔍 检索追溯" Click="Search_Click" Width="90" Height="34" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" />
                    <Button Content="🔄 重置" Click="Reset_Click" Width="70" Height="34" Background="#2D3B4E" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <!-- 一键导出报表 -->
                <Button Grid.Column="1" Content="📥 导出 CSV 质检报表" Click="ExportCsv_Click"
                        Height="34" Padding="14,0" Background="{StaticResource StatusOk}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- 主体区域：左边数据表，右边曲线复盘画布 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左边：生产记录列表 -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,12,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtRecordCount" Text="生产履历台账 (共 0 条)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,8" />

                    <DataGrid Grid.Row="1" x:Name="RecordGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="RecordGrid_SelectionChanged"
                              Background="Transparent" RowBackground="#16202C" AlternatingRowBackground="#1A2533"
                              BorderThickness="0" Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#263445">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="条码 SN" Binding="{Binding WorkpieceBarcode}" Width="150" />
                            <DataGridTextColumn Header="配方" Binding="{Binding RecipeCode}" Width="90" />
                            <DataGridTextColumn Header="品质判定" Binding="{Binding Quality}" Width="85" />
                            <DataGridTextColumn Header="峰值(kN)" Binding="{Binding PeakForce, StringFormat='{}{0:F2}'}" Width="75" />
                            <DataGridTextColumn Header="压深(mm)" Binding="{Binding FinalDisplacement, StringFormat='{}{0:F2}'}" Width="75" />
                            <DataGridTextColumn Header="耗时(s)" Binding="{Binding CycleDurationSec, StringFormat='{}{0:F2}'}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右边：位移-压力历史曲线复盘 -->
            <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 回放抬头 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📈 历史压装位移-压力轨迹复盘" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" />
                        <TextBlock x:Name="TxtReplayDetail" Text="请在左侧列表中点击任意记录查看当时的物理曲线..." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- 曲线重绘画布 -->
                    <Border Grid.Row="1" Background="#0C121A" CornerRadius="6" BorderBrush="#1E2A38" BorderThickness="1" ClipToBounds="True">
                        <Canvas x:Name="ReplayCanvas" Margin="25" />
                    </Border>

                    <!-- 缺陷详细原因诊断 -->
                    <Border Grid.Row="2" Background="#161F2B" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="诊断分析与超限原因:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="TxtFailureMsg" Text="无异常信息" FontSize="13" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
